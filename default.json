{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":separateMultipleMajorReleases",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Taipei",
  "schedule": ["* * * * 1"],
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "schedule": ["* * * * 1"]
  }
}
